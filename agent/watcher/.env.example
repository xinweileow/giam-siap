# Same contract wiring as agent/sui-mcp/.env.example — the watcher is its own deployed process
# (§4.6) and needs its own copy of these at runtime.
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PACKAGE_ID=0x...
SUI_AGENT_CAP_ID=0x...
SUI_VENDOR_REGISTRY_ID=0x...
SUI_CLOCK_ID=0x6
AGENT_PRIVATE_KEY=suiprivkey1...

# The pubkey checkVendorPrice verifies quotes against. Dev-only today: set this to the same value
# as agent/sui-mcp/.env's DEV_VENDOR_PUBKEY_HEX. Swap for teammates' real vendor pubkey once it's
# registered into VendorRegistry via AdminCap (§7 step 2b) — no code change needed, just this var.
VENDOR_PUBKEY_HEX=...

# §4.3 specifies 15-30s; default below is in that range.
WATCHER_POLL_INTERVAL_MS=20000
# Consecutive vendor-check failures (per order+vendor URL) before the watcher raises an alert (§9.1).
WATCHER_ALERT_THRESHOLD=3

# --- dev/vendor-stub.ts only (a local stand-in for teammates' mock vendor site, §7 step 2b) ---
DEV_VENDOR_PRIVATE_KEY=suiprivkey1...
STUB_SUPPLIER_ADDRESS=0x...
VENDOR_STUB_PORT=4100
STUB_PRICE_CENTS=1200
