# Same contract wiring as agent/sui-mcp/.env.example — the watcher is its own deployed process
# (§4.6) and needs its own copy of these at runtime.
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PACKAGE_ID=0x...
SUI_AGENT_CAP_ID=0x...
SUI_VENDOR_REGISTRY_ID=0x...
SUI_CLOCK_ID=0x6
AGENT_PRIVATE_KEY=suiprivkey1...

# The pubkey checkVendorPrice verifies quotes against. Optional for local dev — if unset, falls
# back to agent/sui-mcp/.env's DEV_VENDOR_PUBKEY_HEX automatically. Set this explicitly once
# teammates' real vendor pubkey is registered into VendorRegistry via AdminCap (§7 step 2b) — no
# code change needed, just this var.
# VENDOR_PUBKEY_HEX=...

# §4.3 specifies 15-30s; default below is in that range.
WATCHER_POLL_INTERVAL_MS=20000
# Consecutive vendor-check failures (per order+vendor URL) before the watcher raises an alert (§9.1).
WATCHER_ALERT_THRESHOLD=3

# --- Telegram wiring (§4.3 point 2, §9.1's onAlert, TODOS.md "Wire the watcher's checkNow()/
# onAlert hooks to Telegram") ---
# Loopback-only HTTP port exposing POST /check-now — Hermes hits this via the terminal tool when
# the owner asks to "check now" instead of waiting for WATCHER_POLL_INTERVAL_MS. Must match
# agent/hermes.config/context.json's watcher.checkNowUrl if changed.
WATCHER_HTTP_PORT=4300
# Set to "false" to disable Telegram notifications entirely (falls back to console logging only —
# e.g. CI, or a machine with no Hermes profile set up).
TELEGRAM_NOTIFY_ENABLED=true
# Path to the hermes executable, or a bare name resolved via PATH (see `where hermes`/`which hermes`).
HERMES_SEND_BIN=hermes
# The Hermes profile holding this project's Telegram bot token + home chat id — see
# agent/hermes.config/README.md. `hermes send` reuses that profile's credentials directly; no
# running gateway or LLM call needed.
HERMES_SEND_PROFILE=giam-siap
# `hermes send --to` target. "telegram" sends to that profile's configured home channel.
TELEGRAM_NOTIFY_TARGET=telegram

# --- dev/vendor-stub.ts only (a local stand-in for teammates' mock vendor site, §7 step 2b) ---
DEV_VENDOR_PRIVATE_KEY=suiprivkey1...
STUB_SUPPLIER_ADDRESS=0x...
VENDOR_STUB_PORT=4100
STUB_PRICE_CENTS=1200
