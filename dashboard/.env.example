# Read-only dashboard — no private key needed, only public chain-identifying values
# (same packageId/object IDs agent/sui-mcp uses, see IMPLEMENTATION_PLAN.md "Current status").
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_NETWORK=testnet
SUI_PACKAGE_ID=0x...
SUI_VENDOR_REGISTRY_ID=0x...

# Poll interval for the server-side event/object refresh, in ms (see §5.2). Defaults to 5000.
DASHBOARD_POLL_INTERVAL_MS=5000

# --- zkLogin scaffold (§4.5, §7 step 6) — NOT wired into a live order flow yet, see TODOS.md.
# Untestable without real values below; leave unset to leave /auth and /sign non-functional
# without breaking the rest of the dashboard. ---
# Public Enoki API key (portal.enoki.mystenlabs.com) — safe to expose client-side, scoped to
# zkLogin only (no sponsorship secret). NEXT_PUBLIC_ prefix required so the browser can read it.
NEXT_PUBLIC_ENOKI_API_KEY=enoki_public_...
# Google OAuth client id registered in Google Cloud Console, redirect URI set to
# <dashboard origin>/auth (§2.4, §4.5 step 1).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# Must match SUI_NETWORK above; duplicated with a NEXT_PUBLIC_ prefix because the /auth and /sign
# pages are client components and can't read the server-only SUI_NETWORK var.
NEXT_PUBLIC_SUI_NETWORK=testnet

# Where /api/owner-session and /api/pending-tx persist their small JSON files (§4.5 steps 2-3).
# Defaults to a repo-local, gitignored dashboard/.data/ for local dev — point this at a mounted
# volume in deployment (§4.6), same treatment as the agent side's persistent /data mount.
# DASHBOARD_DATA_DIR=/data/dashboard

# Real Enoki gas-station sponsorship (§4.5's "owner never touches gas" promise) — server-only
# secret, NEVER expose client-side (no NEXT_PUBLIC_ prefix, never read outside
# dashboard/src/lib/enokiServer.ts and the /api/sponsor-transaction* routes it backs).
ENOKI_SECRET_KEY=enoki_private_...
